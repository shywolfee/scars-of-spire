string motdhash;
string webdir="http://darkserver.ru/tk2/motd";
void getmotd()
{
string mode=url_get(webdir+"/mode.txt");
if(mode!="t"&&mode!="a") return;
if(mode=="t")
{
string motd=url_get(webdir+"/text.txt");
if(string_hash(motd,2,false)!=motdhash)
{
motdhash=string_hash(motd,2,false);
p.play_stationary("motdstart.wav",false);
motd_form("Message of the Day", motd);
sound ms;
ms.load("motdend.wav");
ms.play_wait();
ms.close();
return;
}
}
if(mode=="a")
{
speak("loading audio message of the day...");
string motd=url_get(webdir+"/audio.ogg");
string hash=string_hash(motd,2,false);
if(hash!=motdhash)
{
motdhash=hash;
dlgplay(motd,true,15, false);
}
}
}
void motd_form(string title, string message)
{
audio_form f;
f.create_window(title, true, true);
f.create_status_bar("Message", message);
int btn_ok=f.create_button("&OK", true, true);
while(true)
{
f.monitor();
if(f.is_pressed(btn_ok))
{
f.reset();
return;
}
wait(5);
}
}
void show_motd_ingame(string message)
{
audio_form f;
f.create_window("Message of the Day", true, true);
f.create_status_bar("Message", message);
int btn_ok=f.create_button("&OK", true, true);
while(true)
{
f.monitor();
if(f.is_pressed(btn_ok))
{
f.reset();
return;
}
wait(5);
}
}