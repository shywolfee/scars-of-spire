string netaddress="localhost";
int netport=1316;
uint peer_id=0;
string oldservers;
string lookname;
bool prior_connected=false;
string charname;
void login()
{
if(name==""||password=="")
{
dlg("Please setup your account that you want to use to login, or if you don't have an account, please create one");
mainmenu();
return;
}
if(connected==false and prior_connected==false)
{
speak("connecting to server");
if(n.active)
reset_network();
n.setup_client(20, 500);
n.connect(netaddress, netport);
if(get_last_error()!=0)
{
alert("error","network failed to initialize. Error code: "+get_last_error());
mainmenu();
}
}
if(connected==true or prior_connected==true)
{
e=n.request();
send_reliable(0, "login "+name+" "+password+" "+netver+" "+compid, 0);
}
timeouttimer.restart();
while(true)
{
wait(5);
if(speed_stop_is_hacking(200)==true)
killbitch();
e=n.request();
if (key_pressed(KEY_ESCAPE))
{
mainmenu();
}
if(e.type==event_connect and connected==false)
{
peer_id=e.peer_id;
wait(50);
speak("logging in as "+name+"...");
p.play_stationary("connected.ogg",false);
send_reliable(0, "login "+name+" "+password+" "+netver+" "+compid, 0);
connected=true;
}
else if(e.type==event_receive and get_event_message()=="loggedin")
{
wait(50);
p.update_listener_3d(me.x, me.y, me.z);
sourcecheckloop();
checkloc();
game();
}
else if(e.type==event_receive and get_event_message()=="nochar")
{
dlg("the account that you were requested to login does not exist on the server, please check your account name to be sure it is typed correctly");
reset_network();
mainmenu();
}
else if(e.type==event_receive and get_event_message()=="wrongpass")
{
dlg("the password is incorrect");
reset_network();
mainmenu();
}
else if(e.type==event_receive and get_event_message()=="alreadyplaying")
{
dlg("sorry: this account is already logged in");
reset_network();
mainmenu();
}
else if(e.type==event_receive and get_event_message()=="nocharacters")
{
speak("You have no characters yet. Create one now.");
create_character_form();
}
else if(e.type==event_receive and get_event_message()=="login_disabled")
{
dlg("login disabled: please try again later");
reset_network();
mainmenu();
}
else if(e.type==event_receive and get_event_message()=="banned")
{
dlg("error, You are currently banned from the game. please try again later");
reset_network();
mainmenu();
}
else if(e.type==event_receive and get_event_message()=="charcreated")
{
dlg("Character created successfully!");
send_reliable(0, "login "+name+" "+password+" "+netver+" "+compid, 0);
}
else if(e.type==event_receive)
{
string msg=get_event_message();
string[] parsed=string_split(msg, " ", false);
if(parsed.length()>0)
{
if(parsed[0]=="block")
{
dlg(string_trim_left(msg,6));
reset_network();
mainmenu();
}
else if(parsed[0]=="charlist")
{
string[] chars;
for(uint i=1; i<parsed.length(); i++)
chars.insert_last(parsed[i]);
char_select_form(chars);
}
else if(parsed[0]=="x")
{
me.x=string_to_number(parsed[1]);
}
else if(parsed[0]=="oldver" and parsed.length()>1)
{
dlg("you need to update the game if you would like to continue playing");
reset_network();
mainmenu();
}
else if(parsed[0]=="y")
{
me.y=string_to_number(parsed[1]);
}
else if(parsed[0]=="z")
{
me.z=string_to_number(parsed[1]);
}
else if(parsed[0]=="mapname")
{
mapname=parsed[1];
}
else if(parsed[0]=="account")
{
// Server confirms our account name
}
else if(parsed[0]=="motd")
{
motd=string_trim_left(msg,5);
}
else if(parsed[0]=="spawn_player")
{
int x=stn(parsed[1]);
int y=stn(parsed[2]);
int z=stn(parsed[3]);
string n=parsed[4];
string mp=parsed[5];
if(n!=charname and n!=name)
{
spawn_player(x,y,z,mp,n);
}
}
else if(parsed[0]=="m_data")
{
load_map(string_replace(msg, "mdata ", "", false));
}
else if(parsed[0]=="facing")
{
facing=string_to_number(parsed[1]);
}
else if(string_contains(msg,"error",1)>-1 or string_contains(msg,"Error",1)>-1)
{
dlg(msg);
reset_network();
mainmenu();
}
}
}
if(timeouttimer.elapsed>=timeouttime and connected==false)
{
dlg("Server is offline");
reset_network();
mainmenu();
}
}
}
void char_select_form(string[] chars)
{
audio_form f;
f.create_window("Select Character", true, true);
int char_list=f.create_list("&Characters");
for(uint i=0; i<chars.length(); i++)
{
f.add_list_item(char_list, chars[i]);
}
int btn_select=f.create_button("&Select", true);
int btn_create=f.create_button("&Create new character");
int btn_back=f.create_button("&Back", false, true);
while(true)
{
f.monitor();
if(f.is_pressed(btn_select))
{
int sel=f.get_list_position(char_list);
if(sel>=0 and sel<chars.length())
{
charname=chars[sel];
f.reset();
speak("Loading "+charname+"...");
send_reliable(0, "pickchar "+charname, 0);
return;
}
else
{
speak("Please select a character");
}
}
if(f.is_pressed(btn_create))
{
f.reset();
create_character_form();
return;
}
if(f.is_pressed(btn_back))
{
f.reset();
reset_network();
mainmenu();
return;
}
wait(5);
}
}
void create_character_form()
{
audio_form f;
f.create_window("Create Character", true, true);
int inp_name=f.create_input_box("Character &name:");
int btn_create=f.create_button("C&reate", true);
int btn_cancel=f.create_button("&Cancel", false, true);
while(true)
{
f.monitor();
if(f.is_pressed(btn_create))
{
string cname=f.get_text(inp_name);
if(cname=="" or string_contains(cname, " ", 1)!=-1)
{
speak("Character name cannot be empty or contain spaces");
}
else
{
charname=cname;
f.reset();
speak("Creating character...");
send_reliable(0, "makechar "+cname, 0);
return;
}
}
if(f.is_pressed(btn_cancel))
{
f.reset();
reset_network();
mainmenu();
return;
}
wait(5);
}
}
void create()
{
audio_form f;
f.create_window("Create Account", true, true);
int inp_user=f.create_input_box("&Username:");
int inp_pass=f.create_input_box("&Password:", "", "*");
f.create_status_bar("Note", "Password must be at least 8 characters, contain a capital letter and a number.");
int btn_create=f.create_button("C&reate", true);
int btn_cancel=f.create_button("&Cancel", false, true);
string user="";
string pass="";
while(true)
{
f.monitor();
if(f.is_pressed(btn_cancel))
{
f.reset();
creating=false;
reset_network();
mainmenu();
return;
}
if(f.is_pressed(btn_create))
{
user=f.get_text(inp_user);
pass=f.get_text(inp_pass);
if(user=="" or string_contains(user, " ", 1)!=-1)
{
speak("Username cannot be empty or contain spaces");
}
else if(pass=="" or string_contains(pass, " ", 1)!=-1 or pass.length()<8 and SCRIPT_COMPILED==true)
{
speak("Sorry, this password is not valid. It must be at least 8 characters with a capital letter and a number.");
}
else
{
f.reset();
break;
}
}
wait(5);
}
speak("Attempting to connect...");
n.setup_client(20, 500);
n.connect(netaddress, netport);
if(connected==true)
{
creating=false;
send_reliable(0, "newchar "+user+" "+pass+" "+ver+" "+compid, 0);
}
timeouttimer.restart();
while(true)
{
wait(5);
e=n.request();
if(speed_stop_is_hacking(200)==true)
killbitch();
if (key_pressed(KEY_ESCAPE))
{
n.destroy();
mainmenu();
}
if(e.type==event_disconnect or timeouttimer.elapsed>=timeouttime)
{
dlg("server is offline");
reset_network();
mainmenu();
}
if(e.type==event_connect and connected==false)
{
peer_id=e.peer_id;
speak("creating");
send_reliable(0, "newchar "+user+" "+pass+" "+ver+" "+compid, 0);
connected=true;
}
else if(e.type==event_receive and get_event_message()=="createdchar")
{
dlg("success! Account created! Press enter to login.");
name=user;
password=pass;
writeprefs();
login();
creating=false;
}
else if(e.type==event_receive and get_event_message()=="alreadyaccount")
{
dlg("Error: This computer is already associated with another account");
exitgame();
creating=false;
}
else if(e.type==event_receive and get_event_message()=="alreadyexists")
{
dlg("This account already exists");
exitgame();
creating=false;
}
else if(e.type==event_receive and string_contains(get_event_message(),"Error",1)>-1)
{
dlg(get_event_message());
creating=false;
reset_network();
mainmenu();
}
}
}

void reset_network(){
n.disconnect_peer(0);
timeouttimer.restart();
peer_id=0;
n.destroy();
prior_connected=false;
connected=false;
@n=null;
network t;
@n=t;
}

void resetpass()
{
audio_form f;
f.create_window("Reset Password", true, true);
int inp_char=f.create_input_box("&Account name:");
int btn_ok=f.create_button("&Reset", true);
int btn_cancel=f.create_button("&Cancel", false, true);
string char="";
while(true)
{
f.monitor();
if(f.is_pressed(btn_cancel))
{
f.reset();
mainmenu();
return;
}
if(f.is_pressed(btn_ok))
{
char=f.get_text(inp_char);
if(char!="")
{
f.reset();
break;
}
speak("Please enter an account name");
}
wait(5);
}
if(char=="") mainmenu();
n.setup_client(20, 500);
speak("connecting");
n.connect(netaddress,netport);
timeouttimer.restart();
while(true)
{
wait(5);
e=n.request();
if (key_pressed(KEY_ESCAPE))
{
mainmenu();
}
if(e.type==event_disconnect or connected==false and timeouttimer.elapsed>=timeouttime)
{
dlg("server is offline");
reset_network();
mainmenu();
}
if(e.type==event_connect and connected==false)
{
connected=true;
peer_id=e.peer_id;
send_reliable(0,"resetpassword "+char+" "+compid,0);
}
if(e.type==event_receive&&e.channel==6)
{
dlg(get_event_message());
reset_network();
mainmenu();
}
}
}
