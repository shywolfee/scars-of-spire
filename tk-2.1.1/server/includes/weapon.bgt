send_reliable(weapons[j].p.peer_id,"play_s weaponping.ogg",0);
if(weapons[j].type=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(shelters[v].owner)+"'s shelter",2);
if(weapons[j].type=="artillery1") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(shelters[v].owner)+"'s shelter",2);
}
hit=true;
}
}
for(uint v=0; v<vs.length(); v++)
{
if(are_teamed(weapons[j].p.name,vs[v].owner)) continue;
if(get_2d_distance(weapons[j].x,weapons[j].y,vs[v].x,vs[v].y)<=weapons[j].spread&&vs[v].map==weapons[j].map&&vs[v].owner!=weapons[j].p.name and ((vs[v].z>=weapons[j].z&&(vs[v].z<=(weapons[j].z+8))&&weapons[j].type!="artillery")||(vs[v].z>=weapons[j].z&&(vs[v].z<=(weapons[j].z+10))&&weapons[j].type=="artillery")))
if(get_2d_distance(weapons[j].x,weapons[j].y,vs[v].x,vs[v].y)<=weapons[j].spread&&vs[v].map==weapons[j].map&&vs[v].owner!=weapons[j].p.name and ((vs[v].z>=weapons[j].z&&(vs[v].z<=(weapons[j].z+8))&&weapons[j].type!="artillery1")||(vs[v].z>=weapons[j].z&&(vs[v].z<=(weapons[j].z+10))&&weapons[j].type=="artillery1")))
{
string t="";
if(!weapons[j].bullet) t=weapons[j].type;
if(weapons[j].type=="grenade")
{
t="";
spawn_grenade(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
if(weapons[j].type=="pipe_bomb")
{
t="";
spawn_pipe_bomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
if(weapons[j].type=="bottle_bomb")
{
t="";
spawn_bottle_bomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
if(weapons[j].type=="rocket_launcher")
{
t="";
spawn_rocket(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
if(weapons[j].type=="rpg7")
{
t="";
spawn_rpg(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
if(weapons[j].type=="gp30")
{
t="";
spawn_gp(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
if(weapons[j].type=="ags30")
{
t="";
spawn_ags(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
if(weapons[j].type=="m79_grenade_launcher")
{
t="";
spawn_grenade(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
if(weapons[j].type=="stp429_mini_missile")
{
t="";
spawn_mini_missile(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
}
vs[v].hit(random(weapons[j].mindammage,weapons[j].maxdammage),weapons[j].p.name+"'s "+string_replace(weapons[j].type,"artillery","tank",false),t);
//vs[v].hit(random(weapons[j].mindammage,weapons[j].maxdammage),weapons[j].p.name+"'s "+string_replace(weapons[j].type,"artillery1","armored tank",false),t);
if(@weapons[j].p!=null)
{
send_reliable(weapons[j].p.peer_id,"play_s "+(are_teamed(weapons[j].p.name, vs[v].owner)?"weaponpingteam":"weaponping")+".ogg",0);
if(weapons[j].type=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(vs[v].owner,true),2);
if(weapons[j].type=="artillery1") send_reliable(weapons[j].p.peer_id,"hit "+cn2n(vs[v].owner,true),2);
send_reliable(weapons[j].p.peer_id,vs[v].health,2);
}
hit=true;
}
}
if(hit) { @weapons[j]=null;
 weapons.remove_at(j);
 break;
}
}
}
}
}
void spawn_weapon(double x, double y, double z, double dir, string type, string map,player@p1)
{
if(@p1==null) return;
weapon w1(x, y, z, dir, type, map, p1);
//w1=spawn_moving_sound("smallprojectile.ogg",x,y,z,map);
weapons.insert_last(w1);
}
