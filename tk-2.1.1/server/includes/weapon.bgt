shieldchance=60;
}
else if(type=="sniper")
{
bullet=true;
requires_ammo=true;
speedtime=0;
range=100;
mindammage=1000;
maxdammage=10000;
spread=6;
shieldhits=random(15,20);
shieldchance=15;
}
else if(type=="storm_sniper")
{
bullet=false;
requires_ammo=true;
speedtime=0;
range=150;
mindammage=50000;
maxdammage=90000;
spread=6;
shieldchance=100;
hitsounds=3;
}
if(type=="empty_apple_juice")
{
bullet=false;
requires_ammo=false;
speedtime=20;
range=10;
mindammage=10000;
maxdammage=30000;
spread=2;
stunning=true;
stuntime=10000;
shieldchance=100;
}
if(type=="empty_beer_bottle")
{
bullet=false;
requires_ammo=false;
speedtime=20;
range=10;
mindammage=10000;
maxdammage=30000;
spread=2;
stunning=true;
stuntime=10000;
shieldchance=100;
}
else if(type=="the_legendary_sword")
{
bullet=false;
requires_ammo=false;
speedtime=0;
range=20;
mindammage=30000;
maxdammage=130000;
spread=4;
shieldchance=80;
shieldhits=499;
hitsounds=3;
}
}
}
void weaponloop()
{
for(uint j=0; j<weapons.length(); j++)
{
if(weapons[j].speedtimer.elapsed>=weapons[j].speedtime)
{
weapons[j].speedtimer.restart();
vector wr;
wr=move(weapons[j].x,weapons[j].y,weapons[j].dir);
weapons[j].x=wr.x;
weapons[j].y=wr.y;
int rx=round(weapons[j].x, 0);
int ry=round(weapons[j].y, 0);
weapons[j].distance++;
if(weapons[j].distance > weapons[j].range)
{
if(weapons[j].type=="stun_dart" or weapons[j].type=="poison_dart" or weapons[j].type=="health_dart")
{
play("stun_dartdrop",weapons[j].x,weapons[j].y,weapons[j].z,weapons[j].map);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="sticky_bomb")
{
spawn_stickybomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name,"");
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="grenade")
{
spawn_grenade(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="pipe_bomb")
{
spawn_pipe_bomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="bottle_bomb")
{
spawn_bottle_bomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="rocket_launcher")
{
spawn_rocket(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="rpg7")
{
spawn_rpg(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="gp30")
{
spawn_gp(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="ags30")
{
spawn_ags(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="m79_grenade_launcher")
{
spawn_grenade(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else if(weapons[j].type=="stp429_mini_missile")
{
spawn_mini_missile(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
if(weapons[j].type=="invisibility_shield")
{
if(@weapons[j].p!=null)
{
if(weapons[j].p.invisible==false)
{
weapons[j].p.invisible=true;
weapons[j].p.invisibilitytimer.restart();
play("invisibility_start",weapons[j].p.x,weapons[j].p.y,weapons[j].p.z,weapons[j].p.map);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else
{
send_reliable(e.peer_id,"inv invisibility_shield 1",0);
send_reliable(weapons[j].p.peer_id,"You can't go invisible while you're using an invisibility shield",2);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
}
}
if(weapons[j].type=="frequency_scrambler")
{
if(@weapons[j].p!=null)
{
if(weapons[j].p.frequency==false)
{
weapons[j].p.frequency=true;
weapons[j].p.frequencyscramblertimer.restart();
play("frequency_scrambleron",weapons[j].p.x,weapons[j].p.y,weapons[j].p.z,weapons[j].p.map);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
else
{
send_reliable(e.peer_id,"inv frequency_scrambler 1",0);
send_reliable(weapons[j].p.peer_id,"you can't hide from robots while you're using an frequency scrambler",2);
@weapons[j]=null;
weapons.remove_at(j);
break;
}
}
}
else
{
@weapons[j]=null;
weapons.remove_at(j);
break;
}
}
bool hit=false;
string sendtext="";
if(@weapons[j].p!=null)
{
if(string_left(get_tile_at(rx,ry,weapons[j].z,weapons[j].map),4)=="wall" or rx>weapons[j].maxcoords.x or ry>weapons[j].maxcoords.y or rx<0 or ry<0)
{
if(weapons[j].bullet) play("rico"+random(1, 5), rx, ry, weapons[j].z, weapons[j].map);
else if(weapons[j].type=="rocket_launcher")
{
spawn_rocket(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="rpg7")
{
spawn_rpg(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="m79_grenade_launcher")
{
spawn_grenade(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="gp30")
{
spawn_gp(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="ags30")
{
spawn_ags(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="stp429_mini_missile")
{
spawn_mini_missile(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="pipe_bomb")
{
spawn_pipe_bomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="bottle_bomb")
{
spawn_bottle_bomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="sticky_bomb")
{
spawn_stickybomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name,"");
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
else if(weapons[j].type=="grenade")
spawn_grenade(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name);
@weapons[j]=null;
weapons.remove_at(j);
continue;
}
for(uint x=0; x<players.length(); x++)
{
if(are_teamed(weapons[j].p.name,players[x].name)) continue;
if(in_vehicle(players[x].name)>-1 or players[x].is_dead or players[x].invinsible or players[x].newb==1 or players[x].afk) continue;
if(get_3d_distance(rx, ry, weapons[j].z, players[x].x, players[x].y, players[x].z)<=weapons[j].spread and weapons[j].p.name!=players[x].name and players[x].map==weapons[j].map)
{
send_reliable(weapons[j].p.peer_id,"play_s "+(are_teamed(weapons[j].p.name, players[x].name)?"weaponpingteam":"weaponping")+".ogg",0);
if(weapons[j].type=="artillery") send_reliable(weapons[j].p.peer_id,"hit "+players[x].nickname,2);
if(weapons[j].type=="artillery1") send_reliable(weapons[j].p.peer_id,"hit "+players[x].nickname,2);
hit=true;
if(weapons[j].type!="grenade" or weapons[j].type!="sticky_bomb" or weapons[j].type!="ags30" or weapons[j].type!="stp429_mini_missile" or weapons[j].type!="fists" or weapons[j].type!="rpg7" or weapons[j].type!="pipe_bomb" or weapons[j].type!="bottle_bomb" or weapons[j].type!="rocket_launcher" or weapons[j].type!="gp30" or weapons[j].type!="m79_grenade_launcher")
{
if(players[x].shielded and random(0,100)>weapons[j].shieldchance)
{
players[x].playsound("shieldhit"+random(1,12));
players[x].shieldshots-=weapons[j].shieldhits;
players[x].statchangetimer.restart();
}
else
{
if(weapons[j].bullet) play("body"+random(1,3),players[x].x,players[x].y,players[x].z,players[x].map);
else {
string hitsound;
if(weapons[j].hitsounds==0) hitsound=weapons[j].type+"hit";
else
hitsound=weapons[j].type+"hit"+random(1,weapons[j].hitsounds);
play(hitsound,players[x].x,players[x].y,players[x].z,players[x].map);
send_reliable(0,"distsound "+hitsound+"hitdist "+players[x].x+" "+players[x].y+" "+players[x].z+" "+players[x].map,0);
}
int inpact=random(weapons[j].mindammage,weapons[j].maxdammage);
if(inpact>0) players[x].hit(weapons[j].mindammage,weapons[j].maxdammage);
if(weapons[j].type!="artillery"&&weapons[j].type!="artillery1"&&weapons[j].type!="admingun") players[x].should_subtract=true;
else players[x].should_subtract=false;
}
if(weapons[j].stunning)
{
players[x].stun(weapons[j].stuntime,false,false);
}
players[x].hitby=weapons[j].p.name+"'s "+weapons[j].type;
if(weapons[j].type=="artillery") players[x].hitby=weapons[j].p.name+"'s tank";
if(weapons[j].type=="artillery1") players[x].hitby=weapons[j].p.name+"'s armored tank";
//есле попадаем по игроку, передать его здоровье!
send_reliable(weapons[j].p.peer_id,players[x].health,2);
}
else if(weapons[j].type=="sticky_bomb")
{
spawn_stickybomb(rx,ry,weapons[j].z,weapons[j].dir,weapons[j].map,weapons[j].p.name,players[x].name);
}
if(weapons[j].type=="grenade")
{
spawn_grenade(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="pipe_bomb")
{
spawn_pipe_bomb(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="bottle_bomb")
{
spawn_bottle_bomb(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="rocket_launcher")
{
spawn_rocket(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="rpg7")
{
spawn_rpg(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="gp30")
{
spawn_gp(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="ags30")
{
spawn_ags(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="m79_grenade_launcher")
{
spawn_grenade(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="stp429_mini_missile")
{
spawn_mini_missile(players[x].x,players[x].y,players[x].z,players[x].facing,players[x].map,weapons[j].p.name);
}
if(weapons[j].type=="health_dart")
{
players[x].playsound("stun_darthit");
players[x].playsound("hit"+random(1,5));
if(players[x].warping&&players[x].warpstage==0)
{
players[x].playsound("wpfail");
players[x].warping=false;
send_reliable(players[x].peer_id,"startmoving",0);
}
int val=random(400,4000);
weapons[j].p.health+=val;
players[x].health-=val;
}
if(weapons[j].type=="stun_dart")
{
//players[x].hitby=weapons[j].p.name+"'s stun dart";
players[x].stun(5000,true,true,5000);
if(players[x].warping&&players[x].warpstage==0)
{
players[x].playsound("wpfail");
players[x].warping=false;
}
}
else if(weapons[j].type=="poison_dart")
{
players[x].playsound("objecthit");
