}
for (uint i2=0; i2<players.length(); i2++)
{
if(in_vehicle(players[i2].name)>-1 or players[i2].newb==1 or players[i2].is_dead or players[i2].invinsible or players[i2].map=="store") continue;
{
players[i2].health=-1;
players[i2].should_subtract=true;
players[i2].hitby=nuclear_bombs[i].owner+"'s nuclear bomb";
players[i2].playsound("suicidebombhit");
}
