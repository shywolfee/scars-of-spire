for (uint i2=0; i2<remguns.length(); i2++)
{
if (get_3d_distance(motion_bombs[i].x,motion_bombs[i].y,motion_bombs[i].z,remguns[i2].x,remguns[i2].y,remguns[i2].z)<=20 and remguns[i2].map==motion_bombs[i].map)
