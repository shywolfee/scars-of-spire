void create_motion_bomb_from_datastream(string data)
{
dictionary d=deserialize(data);
int x=dget_int(d,"x"),y=dget_int(d,"y"),z=dget_int(d,"z");
string map=dget_string(d,"map"),owner=dget_string(d,"owner");
motion_bomb m1(x,y,z,map,owner);
motion_bombs.insert_last(m1);
}
void create_motion_bomb_array_from_datastream(string stream)
{
dictionary@ temp=deserialize(stream);
string[] keys=temp.get_keys();
for(uint i=0; i<keys.length(); i++)
{
string val=dget_string(temp,keys[i]);
create_motion_bomb_from_datastream(val);
}
@temp=null;
}
string[] create_datastream_from_motion_bomb(motion_bomb@ m)
{
dictionary d;
d.set("x",m.x);d.set("y",m.y);d.set("z",m.z);d.set("owner",m.owner);d.set("map",m.map);
string[] ret(2);
ret[0]=randomstring(5);
ret[1]=serialize(d);
return ret;
}
string create_datastream_from_motion_bomb_array()
{
dictionary d;
for(uint i=0; i<motion_bombs.length(); i++)
{
string[] r=create_datastream_from_motion_bomb(motion_bombs[i]);
d.set(r[0],r[1]);
}
return serialize(d);
}
nuclear_bomb@[] nuclear_bombs(0);
class nuclear_bomb
{
string owner;
int z;
string map;
int x, y;
int seconds=30000;
int beeptime;
timer beeptimer, bombtimer;
int rseconds;
nuclear_bomb(int tx,int ty,int tz, string tmap, string towner, int trseconds)
{
owner=towner;
x=tx;
y=ty;
z=tz;
map=tmap;
rseconds=trseconds;
} // constructor.
} // class.nuclear_bomb.
void nuclear_bombloop()
{
for (uint i=0; i<nuclear_bombs.length(); i++)
{
nuclear_bombs[i].seconds=nuclear_bombs[i].rseconds-nuclear_bombs[i].bombtimer.elapsed;
nuclear_bombs[i].beeptime=nuclear_bombs[i].seconds/5+50;
if (nuclear_bombs[i].beeptimer.elapsed>=nuclear_bombs[i].beeptime)
{
nuclear_bombs[i].beeptimer.restart();
play("nuclear_bombbeep",nuclear_bombs[i].x,nuclear_bombs[i].y,nuclear_bombs[i].z,nuclear_bombs[i].map,-1,true,false);
}
if (nuclear_bombs[i].seconds<=0)
{
send_reliable(0, nuclear_bombs[i].owner+"'s nuclear bomb just exploded! ", 2);
send_reliable(0,"play_s nuclear_bomb.ogg",0);
send_reliable(0,"distsound nuclearbombdist "+nuclear_bombs[i].x+" "+nuclear_bombs[i].y+" "+nuclear_bombs[i].z+" "+nuclear_bombs[i].map,0);
for(uint r=0; r<robots.length(); r++)
{
robots[r].hit(random(1000000000,1000000000),nuclear_bombs[i].owner+"'s nuclear bomb");
}
for(uint i2=0; i2<impact_bombs.length(); i2++)
{
impact_bombs[i2].health=-1;
