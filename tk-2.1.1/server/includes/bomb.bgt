for(uint v=0; v<vs.length(); v++)
{
if(get_3d_distance(remote_bombs[i].x,remote_bombs[i].y,remote_bombs[i].z,vs[v].x,vs[v].y,vs[v].z)<=30&&vs[v].map==remote_bombs[i].map)
