string chartrash()
{
int del=0;
int total=0;
string names;
string ret;
string[] accts=find_directories("accounts/*");
for (uint a=0; a<accts.length(); a++)
{
string[] chars=find_directories("accounts/"+accts[a]+"/*");
for (uint i=0; i<chars.length(); i++)
{
total+=1;
string charpath="accounts/"+accts[a]+"/"+chars[i];
if(filterchar(chars[i],true) and !file_exists(charpath+"/paid.usr")==false)
{
directory_delete(charpath);
names+="\r\n"+chars[i]+", reason: invalid";
del+=1;
}
if (string_is_digits(chars[i]) and !file_exists(charpath+"/paid.usr"))
{
directory_delete(charpath);
names+="\r\n"+chars[i]+", reason: numeric";
del+=1;
}
if (chars[i].length()<=2&&chars[i]!="x0" and chars[i]!="x1" and !file_exists(charpath+"/paid.usr"))
{
directory_delete(charpath);
names+="\r\n"+chars[i]+", reason: less than 3 chars.";
del+=1;
}
if(file_exists(charpath+"/info.usr")==false and !file_exists(charpath+"/paid.usr"))
{
directory_delete(charpath);
names+="\r\n"+chars[i]+", reason: outdated";
del+=1;
}
}
}
ret="Out of "+total+", there were a total of "+del+"("+round(percent(del,total),0)+"percent)  characters that were considered spam.";
file c;
c.open("char_spam.svr","wb");
c.write(names);
c.close();
return ret;
}
