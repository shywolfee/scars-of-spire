{
return (this.master or this.dev);
}
int distancecheck(double xx,double yy,double zz)
{
return get_3d_distance(x,y,z,xx,yy,zz);
}
int warpdist=0;
int warpmoved=0;
vector max,warp;
void warpcheck()
{
if(warpstage==0 and warptimer.elapsed>=2460)
{
send_reliable(peer_id,"freezestart",0);
invinsible=true;
playsound("wpvanish");
send_plus(this.peer_id,"distsound wpvanishdist "+x+" "+y+" "+z+" "+map,0);
z+=1000;
//send_reliable(peer_id,"move "+x+" "+y+" "+z,0);
warpstage=1;
warpdist=random(100,150);
max=get_max_values(map);
warp.x=x;
warp.y=y;
warp.z=z;
send_reliable(peer_id,"play_s wpmid.ogg",0);
warptimer.restart();
}
if(warpstage==1 and warpmoved<warpdist and warptimer.elapsed<2000)
{
warp=move(warp.x,warp.y,facing);
warpmoved++;
if(warp.x>=max.x)
{
warp.x=max.x;
}
if(warp.y>=max.y)
{
warp.y=max.y;
}
if(warp.x<=0) warp.x=0;
if(warp.y<=0) warp.y=0;
}
if(warpstage==1 and warptimer.elapsed>=2000)
{
if(warpmoved<warpdist)
{
do
{
warp=move(warp.x,warp.y,facing);
warpmoved++;
if(warp.x>=max.x)
{
warp.x=max.x;
}
if(warp.y>=max.y)
{
warp.y=max.y;
}
if(warp.x<=0) warp.x=0;
if(warp.y<=0) warp.y=0;
}
while(warpmoved<warpdist);
}
warpstage=0;warpdist=0;warpmoved=0;
warping=false;
warp.x=round(warp.x,0);
warp.y=round(warp.y,0);
x=warp.x;y=warp.y;z-=1000;
send_reliable(peer_id,"move "+x+" "+y+" "+z,0);
invinsible=false;
send_reliable(peer_id,"freezestop",0);
send_reliable(peer_id,"startmoving",0);
playsound("wpappear");
send_plus(this.peer_id,"distsound wpappeardist "+x+" "+y+" "+z+" "+map,0);
}
}
int bikedist=0;
int bikemoved=0;
vector maxb,bike;
void bikecheck()
{
if(bikestage==0 and biketimer.elapsed>=1)
{
invinsible=false;
z=0;
//send_reliable(peer_id,"move "+x+" "+y+" "+z,0);
bikestage=1;
bikedist=5;
max=get_max_values(map);
bike.x=x;
bike.y=y;
bike.z=z;
biketimer.restart();
}
if(bikestage==1 and bikemoved<bikedist and biketimer.elapsed<400)
{
bike=move(bike.x,bike.y,facing);
bikemoved++;
if(bike.x>=max.x)
{
bike.x=max.x;
}
if(bike.y>=max.y)
{
bike.y=max.y;
}
if(bike.x<=0) bike.x=0;
if(bike.y<=0) bike.y=0;
}
if(bikestage==1 and biketimer.elapsed>=400)
{
if(bikemoved<bikedist)
{
do
{
bike=move(bike.x,bike.y,facing);
bikemoved++;
if(bike.x>=max.x)
{
bike.x=max.x;
}
if(bike.y>=max.y)
{
bike.y=max.y;
}
if(bike.x<=0) bike.x=0;
if(bike.y<=0) bike.y=0;
}
while(bikemoved<bikedist);
}
bikestage=0;bikedist=0;bikemoved=0;
bikeusage=false;
bike.x=round(bike.x,0);
bike.y=round(bike.y,0);
x=bike.x;y=bike.y;z-=0;
send_reliable(peer_id,"move "+x+" "+y+" "+z,0);
invinsible=false;
}
}
