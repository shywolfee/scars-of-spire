{
muted+="\r\n"+name;
}
bool unmute(string name)
{
string[] t=string_split(muted,"\r\n",false);
string newmuted;
bool succeeded=false;
for (uint i=0; i<t.length(); i++)
{
if (t[i]!=name)
newmuted+="\r\n"+t[i];
else
succeeded=true;
}
muted=newmuted;
return succeeded;
}
