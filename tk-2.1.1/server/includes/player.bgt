int invpos;
dictionary ammo;
dictionary inv;
int get_ammo_count_from(string we)
{
int amount=0;
for (uint i=0; i<ammo.get_keys().length(); i++)
{
int a=0;
if (ammo.get_keys()[i]==we)
ammo.get(we,a);
amount+=a;
}
return amount;
}
void ammo_give(string we, int amount)
{
int a;
if (!ammo.exists(we))
{
ammo.set(we,amount);
}
else
{
ammo.get(we,a);
if (a+amount<=0)
ammo.delete(we);
else
{
int b=(a+amount);
ammo.delete(we);
ammo.set(we,b);
}
}
}
dictionary inventory;
