//new updater.
#include"includes/HIP.bgt"
#include"includes/dlfile.bgt"
string ver="1.0";
void main()
{
if(!SCRIPT_COMPILED)
{
alert("excuse me","I don't think you should be running this!");
exit();
}
show_game_window("TK updater");
string ver="1.0";
speak("Downloading update...");
string d=dl_file("http://darkserver.ru/tk/upfiles/tk.exe","tk.exe");
if(d=="finished")
d=dl_file("http://darkserver.ru/tk/upfiles/changelog.txt","changelog.txt",false);
if(d=="finished")
d=dl_file("http://darkserver.ru/tk/upfiles/GameEngine.dll","GameEngine.dll",false);
if(d=="finished")
d=dl_file("http://darkserver.ru/tk/upfiles/oggenc2.exe","oggenc2.exe",false);
if(d=="finished")
d=dl_file("http://darkserver.ru/tk/upfiles/nvdaControllerClient32.dll","nvdaControllerClient32.dll",false);
if(d=="finished")
d=dl_file("http://darkserver.ru/tk/upfiles/readme.txt","readme.txt",false);
{
speak("Update downloaded");
wait(2800);
run("tk.exe","",false,false);
}
}
int interrupt=0;
tts_voice tts;
int found_reader=0;
bool speak(string text, bool interrupt=true)
{
if(found_reader==0)
found_reader=auto_select_screen_reader();
if(found_reader==0)
{

// We cannot find a running screen reader, so we use a global tts_voice object.
if(interrupt)
tts.speak_interrupt(text);
else
tts.speak(text);
}

if(interrupt)
screen_reader_speak_interrupt(found_reader, text);
else
screen_reader_speak(found_reader, text);
return true;
}

int auto_select_screen_reader()
{
for(int i=1;i<=4;i++)
{
if(screen_reader_is_running(i)==false)
continue;
return i;
}
return 0;
}