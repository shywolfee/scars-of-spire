int wall_ch=7;
void awall(double x, double y, double z, double face, double zdir)
{
string tid1,tid2,tin,tin1,tin2;
for(int i=0;i<50;i++)
{
vector m=good_move(x,y,z,facing,zdir);
x=m.x; y=m.y; z=m.z;
string tid=get_tile_at(x,y,z);
if(string_left(tid,4)=="wall" || (tid=="" &&vetype!="aircraft"&& vetype!="helecopter"))
{
tin=get_tile_at(x,y,z); break;}
}
if(tin!="")
{
tin1="wall";
int i;
for(i=1;i<=wall_ch;i++)
{
string tid1=get_tile_at(x,y,z+i);
if(tid1==""||string_left(tid1,4)!="wall"){
tin1="none";
break;}
}
z+=i;
}
if(tin=="")
{
tin2="none";
int i=0;
for(i=1;i<wall_ch;i++)
{
string tid1=get_tile_at(x,y,z-i);
if(tid1!="") {
tin2="tile";
break;}
}
z-=i;
}
if(tin1=="wall") updatewsound(wallchek[0],x,y,z, 100);
else if(tin1=="none") updatewsound(wallchek[1],x,y,z,100);
else if(tin2=="none") updatewsound(wallchek[2],x,y,z,100);
else if(tin2=="tile") updatewsound(wallchek[3],x,y,z,100);
}

void wall_chek_right(int x, int y, int z, double facing)
{
double x1 = x;
double y1 = y;
double z1=z;
double rfacing= facing+90;
string tid , tid1,code_mes,tid2;
bool this1;
int i,k,num;
for(i =0;i <5;i++)
{
vector m=move(x1,y1,rfacing);
x1=m.x; y1=m.y;
tid=get_tile_at(x1, y1,z1);
if(string_left(tid,4)=="wall" || (tid=="" &&vetype!="aircraft"&& vetype!="helecopter"))
{
this1=true;
break;
}
}
int x2=x1,y2=y1;
i+=1;
for( int l=0;l<10;l++)
{
vector m5= move(x2,y2,rfacing);
x2=m5.x; y2=m5.y;
}
int k1=3*i;
for(int j1=0;j1<k1; j1++)
{
vector m5= move(x2,y2,rfacing);
x2=m5.x; y2=m5.y;
}


if(string_left(tid,4)=="wall")
{
 code_mes="up";
for(k=1;k<wall_ch;k++)
{
tid2=get_tile_at(x1,y1,z+k);
if(string_left(tid2,4)!="wall")
{
if(get_tile_at(x1,y1,z+k)=="") tid2=get_tile_at(x1,y1,z+k-1);
 break;
}
}
}
if(tid=="")
{
 code_mes="down";
for( k=1;k<wall_ch;k++)
{
tid1=get_tile_at(x1, y1,z1-k);
if(tid1!="") break;
}
}
if(string_left(tid2,4)=="wall"&&code_mes=="up")
{
updatewsound(wallchek[4],x2,y2,z1, 100);
}
if(string_left(tid2,4)!="wall"&&code_mes=="up")
{
updatewsound(wallchek[5],x2,y2,z1+k,100);
}

if(tid1=="" && vetype!="aircraft"&& vetype!="helecopter"&&code_mes=="down")
{
updatewsound(wallchek[6],x2,y2,z1,100);
}
if(tid1!=""&&code_mes=="down")
{
updatewsound(wallchek[7],x2,y2,z1-k,100);
}
}
