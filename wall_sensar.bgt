updatewsound(wallchek[8],x2,y2,z1, 100);
}
if(string_left(tid2,4)!="wall"&&code_mes=="up")
{
updatewsound(wallchek[9],x2,y2,z1+k,100);
}

if(tid1=="" && vetype!="aircraft"&& vetype!="helecopter"&&code_mes=="down")
{
updatewsound(wallchek[10],x2,y2,z1,100);
}
if(tid1!=""&&code_mes=="down")
{
updatewsound(wallchek[11],x2,y2,z1-k,100);
}
}



void wall_sensar(int x, int y, int z, double facing)
{
double x1 = x;
double y1 = y;
double z1=z;
double rfacing= facing;
string tid , tid1,code_mes,tid2;
bool this1;
int i,k,num;
for(i =0;i <10;i++)
{
vector m=move(x1,y1,rfacing);
x1=m.x; y1=m.y;
tid=get_tile_at(x1, y1,z1);
if(string_left(tid,4)=="wall" ||( tid==""&& is_on_tree()<0 && jumped==false&&jumping==false&&falling==false))
{
this1=true;
break;
}
}
int x2=x1,y2=y1;
i+=1;
int k1=2*i;
for(int n=0;n<5;n++)
{
vector m5= move(x2,y2,rfacing);
x2=m5.x; y2=m5.y;
}
for(int j1=0;j1<k1; j1++)
{
vector m5= move(x2,y2,rfacing);
x2=m5.x; y2=m5.y;
}


if(string_left(tid,4)=="wall")
{
 code_mes="up";
for(k=1;k<7;k++)
{
tid2=get_tile_at(x1,y1,z+k);
if(string_left(tid2,4)!="wall")
{
if(get_tile_at(x1,y1,z+k)=="") tid2=get_tile_at(x1,y1,z+k-1);
break;
}
}
}
if(tid=="")
{
 code_mes="down";
for( k=1;k<7;k++)
{
tid1=get_tile_at(x1, y1,z1-k);
if(tid1!="") break;
}
}
if(string_left(tid2,4)=="wall"&&code_mes=="up")
{
updatewsound(wallchek[12],x2,y2,z1, 120);
}
if(string_left(tid2,4)!="wall"&&code_mes=="up")
{
updatewsound(wallchek[13],x2,y2,z1,100);
}

if(tid1=="" && code_mes=="down")
{
if(is_on_tree()<0&&jumped==false&&jumping==false&&falling==false) updatewsound(wallchek[14],x2,y2,z1,100);
}
if(tid1!=""&&code_mes=="down")
{
if(is_on_tree()<0&&jumped==false&&jumping==false&&falling==false) updatewsound(wallchek[15],x2,y2,z1,100);
}
}


