string[] guns={"crossbow","zulfikar","hand_cannon","throwing_knives","str_301_long_barreled_machine_pistol","str_32_pump_action_shotgun","stp106_long_barreled_pistol","stp21_handgun","stp_s84q_automatic_suppressed_pistol","gp30","ags30","sky_127_laser_handgun","sky_28_laser","sig_p226_combat_pistol","saiga_12_30_round_shotgun","s&w_model66_revolver","cop_357_derringer_pistol","ruger_security_6_revolver","colt_python_revolver","colt_ar_15_assault_rifle","nak_nk1000_decimater","modern_sub_machine_gun_carbine","mlk_203_combat_pistol","mlk_207_combat_rifle","m1208_shotgun","m79_grenade_launcher","m24_sniper_rifle","m16_assault_rifle","flame_thrower","crt43_automatic_shotgun","glock_17_pistol","beretta_nano_pocket_pistol","beretta_m1951_machine_pistol","beretta_m9_pistol","barrett_m82_sniper_rifle","cyanide_pistol","gouse_pistol","taser","fnminimilight","cannon","rocket_launcher","rpg7","gauss","pistol","shotgun","awp","sniper"};
void main()
{
string scripttext;
for(uint i=0; i<guns.length(); i++)
{
int ms=get_sound_length("sounds/"+guns[i]+"Reload.ogg");
scripttext+="if(w==\""+guns[i]+"\") return "+ms+";\r\n";
}
alert("done","");
clipboard_copy_text(scripttext);
}
int get_sound_length(string snd)
{
sound s;
s.load(snd);
int ret=s.length;
s.close();
return ret;
}
