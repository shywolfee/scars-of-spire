compid_handler@[]comphandles(0);
class compid_handler
{
string compid;
string playername;
compid_handler(string cid,string pn)
{
compid=cid;
playername=pn;
}
}
void add_compid(string compid,string name)
{
compid_handler ch1(compid,name);
comphandles.insert_last(ch1);
}
bool compid_handlercheck(string c)
{
for(uint i=0; i<comphandles.length(); i++)
{
if(comphandles[i].compid==c)
return true;
}
return false;
}
int get_compid_handler_index(string c)
{
for(uint i=0; i<comphandles.length(); i++)
{
if(comphandles[i].compid==c) {
return i;
}
}
return -1;
}
void load_compids()
{
string[] accts=find_directories("accounts/*");
for(uint i=0; i<accts.length(); i++)
{
string[] chars=find_directories("accounts/"+accts[i]+"/*");
for(uint j=0; j<chars.length(); j++)
{
if(file_exists("accounts/"+accts[i]+"/"+chars[j]+"/compid.usr")==false) continue;
string compid=file_get_contents("accounts/"+accts[i]+"/"+chars[j]+"/compid.usr");
add_compid(compid,chars[j]);
}
}
}