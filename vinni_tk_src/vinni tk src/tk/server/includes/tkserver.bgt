return;
}
file_delete("chars/"+parsed[1]+"/builder.usr");
int id=get_player_index_from(parsed[1]);
if(id>-1)
{
send_reliable(0,"notify "+parsed[1]+" has been demoted from being builder",0);
send_reliable(players[index].peer_id,"play_s warn3.ogg",0);
send_plus(players[index].peer_id,"play_s warn3.ogg",0);
players[id].is_builder=false;
players[id].title="";
}
}
else if(parsed[0]=="/newadmin" and parsed.length()>1)
{
if(players[index].dev)
