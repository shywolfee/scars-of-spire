int select_random_player(string noname="")
{
int[] indexs;
for(uint i=0; i<players.length(); i++)
{
if(players[i].afk==true or players[i].invinsible==true or players[i].is_dead==true or players[i].invisible==true or players[i].name==noname) continue;
indexs.insert_last(get_player_index(players[i].peer_id));
}
if(indexs.length<=0)
{
return -1;
}
else
return indexs[random(0,indexs.length()-1)];
}

void exitsvr()
{
for(uint i=0; i<players.length(); i++)
{
scd(i);
