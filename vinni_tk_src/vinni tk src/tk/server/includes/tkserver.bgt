string get_registered_names()
{
string[] chars=find_directories("chars/*");
string info;
int reg=0;
for(uint i=0; i<chars.length(); i++)
{
if(file_exists("chars/"+chars[i]+"/reginfo.usr"))
{
reg++;
info+=chars[i]+", ";
