}
send_reliable(players[index].peer_id,"weaponlist "+wnames,0);
players[index].oldhealth=players[index].health;
players[index].statchangetimer.force(60000);
players[index].invusetimer.force(60000);
if(beta==true)
{
send_reliable(players[index].peer_id,"Welcome to the killer beta server! Version "+version+ "beta. Type /changes to see what's new, /rules to view rules, and /help to see available commands. Last revision of rules is "+file_get_contents("rules_revision.txt")+". Message of the day: "+motd(),2);
}
else
send_reliable(players[index].peer_id,"Welcome to the killer! Version "+version+". Type /changes to see what's new, /rules to view rules, and /help to see available commands. Last revision of rules is "+file_get_contents("rules_revision.txt")+". Message of the day: "+motd(),2);
