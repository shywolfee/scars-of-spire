if(wname=="mass_bomb")
{
if(players[index].disablebomb==true)
{
takeobj=false;
send_reliable(players[index].peer_id,"the use bombs is disabled",2);
return;
}
if(players[index].masstimer.elapsed<500)
{
takeobj=false;
return;
}
players[index].masstimer.restart();
placemass_bomb(players[index].x,players[index].y,players[index].z,players[index].map,players[index].name);
}
if(wname=="hipersound_bomb")
{
if(players[index].disablebomb==true)
{
takeobj=false;
send_reliable(players[index].peer_id,"the use bombs is disabled",2);
return;
}
if(players[index].hipersoundtimer.elapsed<20000)
{
takeobj=false;
return;
}
players[index].hipersoundtimer.restart();
placehipersound_bomb(players[index].x,players[index].y,players[index].z,players[index].map,players[index].name);
}
if(wname=="motion_bomb")
{
if(players[index].disablebomb==true)
{
takeobj=false;
send_reliable(players[index].peer_id,"the use bombs is disabled",2);
return;
}
if(players[index].mbombtimer.elapsed<1000)
{
takeobj=false;
return;
}
players[index].mbombtimer.restart();
spawn_motion_bomb(players[index].x,players[index].y,players[index].z,players[index].map,players[index].name);
}
