if(songindex==18) return 268956;
if(songindex==19) return 195024;
if(songindex==20) return 151579;
if(songindex==21) return 288216;
if(songindex==22) return 307560;
if(songindex==23) return 197608;
if(songindex==24) return 154488;
if(songindex==25) return 197433;
if(songindex==26) return 213368;
if(songindex==27) return 214883;
if(songindex==28) return 222040;
