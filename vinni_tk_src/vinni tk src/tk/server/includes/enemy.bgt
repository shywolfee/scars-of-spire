enemy@[] enemies(0);
class enemy
{
int x;
int y;
int z;
string map;
string zone;
string owner;
string hitby;
string teamname;
timer stimer;
timer mtimer;
int mtime=300;
timer xtimer;
int health=random(1000,200000);
int id=random(1,100);
enemy(int sx,int sy,int sz,string smap,string soner)
{
x=sx;
y=sy;
z=sz;
map=smap;
owner=soner;
}
}
void enemyloop()
{
for(uint i=0; i<enemies.length(); i++)
{
if(enemies[i].xtimer.elapsed>300000)
{
enemies[i].health=-1;
enemies[i].hitby="dead battery";
}
int oindex=get_player_index_from(enemies[i].owner);
if(oindex<0)
{
enemies[i].health=-1;
enemies[i].hitby="dead battery";
}
if(enemies[i].health<0)
{
play("robotkill"+random(1,3),enemies[i].x,enemies[i].y,enemies[i].z,enemies[i].map);
send_reliable(0,"play_s robotkillalert.ogg",0);
send_reliable(0,"playerdeath "+killmsg(enemies[i].owner+"'s robot "+enemies[i].id,enemies[i].hitby,enemies[i].map),0);
players[i].kills+=1;
enemies.remove_at(i);
continue;
}
int index=get_nearest_player(enemies[i].x,enemies[i].y,enemies[i].z,enemies[i].map,oindex);
if(index>-1)
{
if(players[index].newb==1 or players[index].afk or players[index].is_dead or players[index].invinsible) continue;
if(are_teamed(enemies[i].owner,players[index].name)) continue;
int v=in_vehicle(players[index].name);
int miss=random(1,20);
int dist=get_2d_distance(enemies[i].x,enemies[i].y,players[index].x,players[index].y);
if(dist<8 and enemies[i].stimer.elapsed>1000 and index!=oindex and players[index].z==enemies[i].z)
{
enemies[i].stimer.restart();
play("robotfire"+random(1,3),enemies[i].x,enemies[i].y,enemies[i].z,enemies[i].map);
send_reliable(0,"distsound robotfiredist "+enemies[i].x+" "+enemies[i].y+" "+enemies[i].z+" "+enemies[i].map,0);
if(miss<20)
{
if(v>-1) {
vs[v].hit(random(3000,30000),enemies[i].owner+"'s robot"+enemies[i].id,"robot");
playext("artilleryhit_vehicle",vs[v].x,vs[v].y,vs[v].z,vs[v].map,vs[v].owner);
playint("artilleryhit_vehicle",vs[v].owner);
}
else
if(in_vehicle(players[index].name)>-1)
{
continue;
}
else
{
if(players[index].shielded)
{
players[index].playsound("shieldhit"+random(1,12));
players[index].shieldshots-=random(1,37);
}
else
{
players[index].hit(120,20000);
players[index].hitby=enemies[i].owner+"'s robot "+enemies[i].id;
players[index].playsound("robotimpact"+random(1,3));
}
}
}
}
if(enemies[i].mtimer.elapsed>enemies[i].mtime)
{
enemies[i].mtimer.restart();
if(enemies[i].x<players[index].x)
enemies[i].x++;
else if(enemies[i].x>players[index].x)
enemies[i].x--;
if(enemies[i].y<players[index].y)
enemies[i].y++;
if(enemies[i].y>players[index].y)
enemies[i].y--;
play("robotstep"+random(1,2),enemies[i].x,enemies[i].y,enemies[i].z,enemies[i].map);
}
}
}
}
void spawn_enemy(int x,int y,int z,string map,string owner)
{
enemy s(x,y,z,map,owner);
enemies.insert_last(s);
}
